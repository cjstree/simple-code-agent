LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Optional. Leave empty to run with local coding tools only.
MCP_URL=
MCP_CONNECT_TIMEOUT=3.0

# Optional tracing. Install with: uv sync --extra telemetry
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=code-agent-dev
